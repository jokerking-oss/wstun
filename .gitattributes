# 统一换行符，避免跨平台 diff 噪声
* text=auto

# Windows 批处理 / VBS 必须 CRLF（LF-only 会让 cmd.exe 的标签与多行块解析出错）
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# 其余文本统一 LF
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 二进制
*.png binary
*.jpg binary
*.zip binary
*.7z  binary
